{
 auto_https off
}
http://{$SITE_ADDRESS} {
 handle /api/updates/upload/ {
  request_body {
   max_size 2048MB
  }
  reverse_proxy backend:8000
 }
 handle /api/* {
  request_body {
   max_size {$UPLOAD_LIMIT_MB}MB
  }
  reverse_proxy backend:8000
 }
 handle {
  reverse_proxy frontend:8080
 }
 header {
  X-Content-Type-Options "nosniff"
  Referrer-Policy "same-origin"
 }
}
