# PLACEHOLDERS ONLY. Generate unique values; never deploy this file unchanged.
DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET
CREDENTIAL_KEY=REPLACE_WITH_FERNET_KEY
ALLOWED_HOSTS=inventory.example.invalid,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://inventory.example.invalid
SITE_ADDRESS=inventory.example.invalid
HTTP_PORT=80
HTTPS_PORT=443
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=infrahub
MYSQL_USER=infrahub
